PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# ---- TEST MODE ----
# true  = mail sirf TEST_RECIPIENT ko, subject me [TEST]
# false = asli logon ko (ye sabse aakhir me karna)
TEST_MODE=true
TEST_RECIPIENT=mohankumardalei2001@gmail.com

# ---- Report ----
MAIL_TO=mrutyunjaya.sahu@contify.com,aswini.sahoo@contify.com
MAIL_CC=
SUBJECT_PREFIX=Work Details of
REPORT_SHEET_NAME=Sourcing_Error_Report
SIGNATURE=Mohan Kumar Dalei
# Total Pending = pending + otherIssue ? (sum) ya sirf pending ? (pending)
TOTAL_PENDING_RULE=sum

# ---- Storage ----
# json   = local file (data/history.json) — bina Google setup ke chalta hai
# sheets = Google Sheet (neeche wali values chahiye)
STORE=auto

SHEET_ID=1lh-p_xwuRtQMw3warMGjYsKch-GXUebiA6NllAmC2Fo
SHEET_TAB=Sheet1
PERSON_NAME=Mohan Kumar Dalei
NAME_COLUMN=1
DATE_HEADER_ROW=1
DATE_FORMAT=dd/MM/yyyy
# service account ki json key ka path
GOOGLE_KEY_FILE=./service-account.json

# ---- Mail (nodemailer / SMTP) ----
# Gmail ke liye: normal password nahi, App Password banana padta hai
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Abhi sirf sheet ka kaam ho raha hai, mail baad me
MAIL_ENABLED=false
SHEET_GID=0
# naam ke neeche jis row me roz ka count jaata hai
DATA_ROW_LABEL=Daily Achieved
# cell me number bhi likhein (true) ya sirf note (false)
WRITE_VALUE=true
VALUE_FIELD=sourcing

# OAuth (recommended): Cloud Console -> Credentials -> OAuth client ID -> Desktop app
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=

# note | comment | both   (comment = asli Ctrl+Alt+M wala, Drive API se)
COMMENT_MODE=comment

# History alag sheet me (asli tracker me kuch log nahi hota). Khali chhodo to
# history bilkul save nahi hogi.
LOG_SHEET_ID=
LOG_TAB=Demowork History

# Dusra OAuth client: Workspace ke andar ka "Internal" app.
# Iske bina login screen par sirf ek button aata hai.
OAUTH_WORK_CLIENT_ID=
OAUTH_WORK_CLIENT_SECRET=
OAUTH_WORK_LABEL=Contify account
OAUTH_WORK_DOMAIN=contify.com

# Frontend aur backend alag domain par ho (Render) to:
#   CLIENT_ORIGIN=https://aapka-frontend.onrender.com
#   COOKIE_SAMESITE=none
#   COOKIE_SECURE=true
#   DATA_DIR=/var/data
COOKIE_SAMESITE=lax
COOKIE_SECURE=false
DATA_DIR=data
