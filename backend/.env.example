# ---- server ----
PORT=4000
# Login ke baad user ko kahan wapas bhejna hai.
# Ek hi service me dono chal rahe hon to yahi service ka URL.
# Vite alag chal raha ho (dev) to uska URL. Comma se ek se zyada bhi.
CLIENT_ORIGIN=http://localhost:5173

# https par cookie ke liye Render par COOKIE_SECURE=true
COOKIE_SAMESITE=lax
COOKIE_SECURE=false
SESSION_DAYS=30

# Data (tokens, sessions, team settings, history) kahan rahe.
# Render par disk lagao to /var/data
DATA_DIR=data

# ---- Google login ----
# Cloud Console > Credentials > OAuth client ID > Web application
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
# Render par: https://<backend>.onrender.com/api/auth/callback
OAUTH_REDIRECT=

# Workspace ka alag "Internal" client, agar kabhi banao.
# Inke bina login screen par ek hi button aata hai.
OAUTH_WORK_CLIENT_ID=
OAUTH_WORK_CLIENT_SECRET=
OAUTH_WORK_LABEL=Contify account
OAUTH_WORK_DOMAIN=contify.com

# ---- sheet ----
# Ye sirf pehli baar ke default hain. App me settings badloge to
# wo data/team.json me save hoti hain aur inse upar rehti hain.
SHEET_ID=
SHEET_GID=0
SHEET_TAB=Sheet1
DATA_ROW_LABEL=Daily Achieved
DATE_HEADER_ROW=1
WRITE_VALUE=true
VALUE_FIELD=sourcing
# note | comment | both  (comment = asli Ctrl+Alt+M wala)
COMMENT_MODE=comment
# auto = login mil gaya to sheet, warna local json
STORE=auto
CACHE_TTL_MS=45000

# ---- history ----
LOG_SHEET_ID=
LOG_TAB=Demowork History

# ---- mail ----
MAIL_ENABLED=true
MAIL_TO=
MAIL_CC=
SUBJECT_PREFIX=Work Details of
REPORT_SHEET_NAME=Sourcing_Error_Report
# TEST_MODE on ho to mail sirf TEST_RECIPIENT ko (khali ho to khud ko)
TEST_MODE=false
TEST_RECIPIENT=
# sum = pending + other issue, pending = sirf pending
TOTAL_PENDING_RULE=sum

# ---- service account (optional) ----
# OAuth ke bajaye service account use karna ho to
GOOGLE_KEY_FILE=./service-account.json
